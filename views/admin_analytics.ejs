<!doctype html>
<html>
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Admin Analytics</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
  <div class="container">
    <nav class="navbar"><span class="brand">LabSys Pro</span>
      <div style="float:right">
        <button id="themeToggleBtn" class="btn-outline">Toggle Theme</button>
      </div>
    </nav>
    <div class="grid">
      <div class="card card-sm stat">
        <div class="value">12</div>
        <div class="label">New Tests Today</div>
      </div>
      <div class="card card-sm stat">
        <div class="value">4</div>
        <div class="label">Pending Reports</div>
      </div>
      <div class="card card-sm stat">
        <div class="value">₹ 9,200</div>
        <div class="label">Revenue (This week)</div>
      </div>
    </div>
    <div class="card">
      <h4>Tests per Day</h4>
      <canvas id="chartTests" width="600" height="240"></canvas>
    </div>
    <div class="card">
      <h4>Top Test Types</h4>
      <canvas id="chartTop" width="600" height="240"></canvas>
    </div>
  </div>
  <script src="/public/js/theme.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    const ctx = document.getElementById('chartTests').getContext('2d');
    new Chart(ctx, { type:'line', data: { labels: ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'], datasets:[{label:'Tests', data:[5,8,6,12,9,4,10], tension:0.3, fill:true, backgroundColor:'rgba(13,110,253,0.08)', borderColor:'#0d6efd'}] }, options:{responsive:true}});
    const ctx2 = document.getElementById('chartTop').getContext('2d');
    new Chart(ctx2, { type:'doughnut', data:{ labels:['CBC','Lipid','Sugar','LFT'], datasets:[{data:[30,20,18,12], backgroundColor:['#0d6efd','#6f42c1','#198754','#fd7e14']}] }, options:{responsive:true}});
  </script>
</body>
</html>
