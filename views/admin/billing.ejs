<%- include("../partials/header") %>
<%- include("../partials/sidebar") %>
<link rel="stylesheet" href="/css/theme.css">


<main class="main" style="margin-left:0 !important; padding:25px;">

  <h3 class="text-center mb-4 fw-bold">Billing & Payments</h3>

  <div class="center-wrapper">
    <div class="center-card">

      <!-- SUMMARY CARD -->
      <div class="summary-card shadow-sm p-4 mb-4" style="background:#f1f7ff; border-left:5px solid #0a74ff; border-radius:12px;">
        <h5 class="fw-bold text-primary mb-2">Billing Summary</h5>

        <p class="m-0">
          Total Completed Tests: 
          <strong><%= completed.length %></strong>
        </p>

        <%
          let totalRevenue = 0;
          completed.forEach(c => totalRevenue += (c.testType?.price || 0));
        %>

        <p class="mt-1">
          Total Revenue: 
          <strong class="text-success">₹<%= totalRevenue %></strong>
        </p>
      </div>

      <!-- BILLING TABLE -->
      <div class="table-responsive">
        <table class="table table-hover align-middle text-center">
          <thead class="bg-primary text-white fw-bold">
            <tr>
              <th>Patient</th>
              <th>Test</th>
              <th>Price (₹)</th>
              <th>Completed At</th>
            </tr>
          </thead>

          <tbody>
            <% if (completed.length === 0) { %>
              <tr>
                <td colspan="4" class="text-muted py-4">
                  No completed tests yet.
                </td>
              </tr>
            <% } %>

            <% completed.forEach(t => { %>
            <tr class="bg-light shadow-sm rounded">
              <td>
                <strong><%= t.patient?.name %></strong><br>
                <small class="text-muted">(<%= t.patient?.email %>)</small>
              </td>

              <td><%= t.testType?.name %></td>

              <td class="fw-bold text-success">
                ₹<%= t.testType?.price %>
              </td>

              <td><%= new Date(t.reportGeneratedAt).toLocaleString() %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</main>
<script src="/js/theme.js"></script>

<style>
.center-wrapper {
  display: flex;
  justify-content: center;
}
.center-card {
  width: 95%;
  max-width: 1100px;
  background: white;
  padding: 30px;
  border-radius: 14px;
  box-shadow: 0px 4px 14px rgba(0,0,0,0.08);
}
.table-hover tbody tr:hover {
  background: #eaf2ff;
  transition: 0.2s;
}
thead th {
  color: #fff !important;
  font-weight: 600;
  padding: 12px;
  font-size: 15px;
}
</style>


