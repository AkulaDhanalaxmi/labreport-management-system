<!DOCTYPE html>
<html>
<head>
  <title>Upload Report</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background: #f2f4f7;
      font-family: system-ui, sans-serif;
      padding: 40px 0;
    }

    .upload-card {
      max-width: 900px;
      background: white;
      padding: 40px;
      margin: auto;
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .title {
      font-size: 26px;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .subtitle {
      color: #666;
      margin-bottom: 25px;
      font-size: 15px;
    }

    .section-header {
      font-weight: 700;
      font-size: 18px;
      border-left: 4px solid #007bff;
      padding-left: 10px;
      margin-top: 30px;
      margin-bottom: 15px;
      color: #007bff;
    }

    .value-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    label {
      font-weight: 600;
      margin-bottom: 3px;
    }

    .btn-primary {
      padding: 10px 30px;
      font-size: 16px;
    }

    .btn-cancel {
      margin-left: 10px;
      font-size: 16px;
    }
  </style>
</head>

<body>

<div class="upload-card">

  <div class="title">Upload Report</div>
  <div class="subtitle">Fill in the test values and upload the PDF/image.</div>

  <!-- Patient Info -->
  <div class="row">
    <div class="col-md-6">
      <div class="section-header">Patient Details</div>
      <p><strong>Name:</strong> <%= test.patient.name %></p>
      <p><strong>Email:</strong> <%= test.patient.email %></p>
    </div>

    <div class="col-md-6">
      <div class="section-header">Test Details</div>
      <p><strong>Test:</strong> <%= test.testType.name %></p>

      <% if (test.scheduledAt) { %>
        <p><strong>Scheduled At:</strong> 
           <%= new Date(test.scheduledAt).toLocaleString() %>
        </p>
      <% } %>
    </div>
  </div>

  <form method="POST" action="/admin/generate-report" enctype="multipart/form-data">
    <input type="hidden" name="testId" value="<%= test._id %>">

    <!-- Test Values -->
    <div class="section-header">Enter Test Values</div>

    <div class="value-grid">

      <!-- 🩸 CBC -->
      <% 
        let name = test.testType.name.toLowerCase();
        let isCBC = name.includes('cbc') || name.includes('complete blood count');
        let isSugar = name.includes('blood sugar') || name.includes('glucose');
        let isThyroid = name.includes('thyroid');
        let isLFT = name.includes('lft') || name.includes('liver');
        let isKFT = name.includes('kft') || name.includes('kidney') || name.includes('renal');
        let isUrine = name.includes('urine');
        let isLipid = name.includes('lipid');
        let isElectro = name.includes('electrolyte');
      %>

      <% if (isCBC) { %>
        <div><label>Hemoglobin</label><input name="hemoglobin" class="form-control"></div>
        <div><label>RBC</label><input name="rbc" class="form-control"></div>
        <div><label>WBC</label><input name="wbc" class="form-control"></div>
        <div><label>Platelets</label><input name="platelets" class="form-control"></div>
      <% } %>

      <!-- 🩺 Blood Sugar -->
      <% if (isSugar) { %>
        <div><label>Fasting (mg/dL)</label><input name="fasting" type="number" class="form-control"></div>
        <div><label>Post-Prandial (mg/dL)</label><input name="pp" type="number" class="form-control"></div>
      <% } %>

      <!-- 🧬 Thyroid -->
      <% if (isThyroid) { %>
        <div><label>TSH</label><input name="tsh" class="form-control"></div>
        <div><label>T3</label><input name="t3" class="form-control"></div>
        <div><label>T4</label><input name="t4" class="form-control"></div>
        <div><label>FT3</label><input name="ft3" class="form-control"></div>
        <div><label>FT4</label><input name="ft4" class="form-control"></div>
      <% } %>

      <!-- 🫁 LFT -->
      <% if (isLFT) { %>
        <div><label>ALT</label><input name="alt" class="form-control"></div>
        <div><label>AST</label><input name="ast" class="form-control"></div>
        <div><label>ALP</label><input name="alp" class="form-control"></div>
        <div><label>Total Bilirubin</label><input name="bilirubin_total" class="form-control"></div>
        <div><label>Direct Bilirubin</label><input name="bilirubin_direct" class="form-control"></div>
        <div><label>Albumin</label><input name="albumin" class="form-control"></div>
      <% } %>

      <!-- 🧪 KFT -->
      <% if (isKFT) { %>
        <div><label>Urea</label><input name="urea" class="form-control"></div>
        <div><label>Creatinine</label><input name="creatinine" class="form-control"></div>
        <div><label>Sodium (Na)</label><input name="sodium" class="form-control"></div>
        <div><label>Potassium (K)</label><input name="potassium" class="form-control"></div>
        <div><label>Chloride (Cl)</label><input name="chloride" class="form-control"></div>
      <% } %>

      <!-- 🚽 Urine Routine -->
      <% if (isUrine) { %>
        <div><label>Color</label><input name="urine_color" class="form-control"></div>
        <div><label>Appearance</label><input name="urine_appearance" class="form-control"></div>
        <div><label>pH</label><input name="urine_ph" class="form-control"></div>
        <div><label>Protein</label><input name="urine_protein" class="form-control"></div>
        <div><label>Glucose</label><input name="urine_glucose" class="form-control"></div>
        <div><label>Ketones</label><input name="urine_ketones" class="form-control"></div>
        <div><label>RBC</label><input name="urine_rbc" class="form-control"></div>
        <div><label>WBC</label><input name="urine_wbc" class="form-control"></div>
      <% } %>

      <!-- 🧈 Lipid Profile -->
      <% if (isLipid) { %>
        <div><label>Total Cholesterol</label><input name="cholesterol_total" class="form-control"></div>
        <div><label>HDL</label><input name="hdl" class="form-control"></div>
        <div><label>LDL</label><input name="ldl" class="form-control"></div>
        <div><label>Triglycerides</label><input name="triglycerides" class="form-control"></div>
      <% } %>

      <!-- ⚡ Electrolytes -->
      <% if (isElectro) { %>
        <div><label>Sodium</label><input name="sodium" class="form-control"></div>
        <div><label>Potassium</label><input name="potassium" class="form-control"></div>
        <div><label>Chloride</label><input name="chloride" class="form-control"></div>
        <div><label>Calcium</label><input name="calcium" class="form-control"></div>
      <% } %>

    </div>

    <!-- Summary -->
    <div class="section-header">Summary / Notes</div>
    <textarea name="summary" class="form-control" rows="3" placeholder="Write summary or notes..."></textarea>

    <!-- File Upload -->
    <div class="section-header">Attach Report File (PDF / Image)</div>
    <input type="file" name="extraFile" class="form-control mb-3" accept=".pdf,.jpg,.jpeg,.png">

    <button class="btn btn-primary">Generate PDF & Upload</button>
    <a href="/admin/pending-reports" class="btn btn-outline-secondary btn-cancel">Cancel</a>

  </form>

</div>

</body>
</html>
