<%- include('../partials/header') %>
<%- include('../partials/topnav') %>
<link rel="stylesheet" href="/css/theme.css">

<div class="container p-4">
  
  <h3 class="mb-3">View Report</h3>
  <p class="text-muted">Patient: <strong><%= report.patient.name %></strong> — <%= report.patient.email %></p>
  <p class="text-muted">Test: <strong><%= report.testType.name %></strong></p>

  <div class="card p-3 shadow-sm mt-3">
    <h5 class="mb-3">Report Details</h5>
    
    <% if (report.reportValues) { %>
      <table class="table table-bordered">
        <thead class="table-light">
          <tr>
            <th>Parameter</th>
            <th>Result</th>
          </tr>
        </thead>
        <tbody>
          <% Object.keys(report.reportValues).forEach(function(k){ %>
            <tr>
              <td><%= k.replace(/_/g,' ').toUpperCase() %></td>
              <td><%= report.reportValues[k] %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="text-danger">No numeric data found.</p>
    <% } %>

    <div class="mt-3">
      <h6>Summary</h6>
      <p><%= report.summary || "No summary added" %></p>
    </div>

    <% if (report.reportFile) { %>
      <div class="mt-3">
        <a href="<%= report.reportFile %>" target="_blank" class="btn btn-primary">
          Download PDF Report
        </a>
      </div>
    <% } %>

  </div>

  <a href="/admin/pending-reports" class="btn btn-secondary mt-4">Back</a>

</div>



<%- include('../partials/footer') %>
