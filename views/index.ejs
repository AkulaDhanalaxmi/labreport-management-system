<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lab Research Landing</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      font-family: "Poppins", sans-serif;
      background: #f5f5f5;
      overflow-x: hidden;
      padding: 40px;
    }

    .hero-section {
      padding: 0;
    }

    .tag {
      display: inline-block;
      background: #dff6e8;
      color: #2e8b57;
      padding: 6px 14px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 15px;
    }

    .title {
      font-size: 60px;
      font-weight: 700;
      color: #1e1e2d;
      line-height: 1.15;
      max-width: 600px;
    }

    .subtitle {
      color: #4f4f63;
      font-size: 18px;
      max-width: 550px;
      margin-top: 20px;
    }

    .btn-start {
      background: #29cc6d;
      color: #fff;
      padding: 12px 28px;
      border-radius: 30px;
      border: none;
      font-weight: 600;
      margin-right: 12px;
      cursor: pointer;
    }

    .btn-login {
      background: transparent;
      border: 2px solid #29cc6d;
      color: #29cc6d;
      padding: 12px 28px;
      border-radius: 30px;
      font-weight: 600;
      cursor: pointer;
    }

    /* FIXED PERFECT IMAGE SIZE */
    .lab-image {
      width: 115%;
      margin-left: -33px;
      border-radius: 22px;
      box-shadow: 0 10px 35px rgba(0,0,0,0.18);
    }
  </style>
</head>

<body>

<!-- FIXED CARD SIZE -->
<div class="container" style="
  max-width:1500px;
  background:white;
  padding:122px 90px;
  border-radius:35px;
  box-shadow:0 20px 50px rgba(0,0,0,0.15);
  margin-bottom:40px;
">

<section class="hero-section container-fluid">
  <div class="row align-items-center">

    <div class="col-md-6">
      <span class="tag">LABORATORY</span>

      <h1 class="title">Space Physics <br> Research Laboratory</h1>

      <p class="subtitle">
        Committed to knowledge dissemination, our laboratory is dedicated to educate next generation space scientists.
      </p>

      <div class="mt-4">
        <button class="btn-start" onclick="location.href='/register'">Get Started</button>
        <button class="btn-login" onclick="location.href='/login'">Login</button>
      </div>
    </div>

    <div class="col-md-6 text-center">
      <!-- PERFECT IMAGE WIDTH -->
      <img src="/assets/land.png" alt="Laboratory Image" class="lab-image">
    </div>

  </div>
</section>

</div>

</body>
</html>
