
<!doctype html>
<html>
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Report View</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body{background:#f4f8ff;font-family:Arial;margin:0;padding:20px}
    .card{border-radius:12px}
  </style>
</head>
<body>
  <%- include("../partials/sidebar") %>
  <div class="container">
    <a href="/patient/dashboard" class="btn btn-link mb-3">&larr; Back to Dashboard</a>
    <div class="card p-3">
      <div class="d-flex justify-content-between">
        <div>
          <h4>Report: <%= test.testType.name %></h4>
          <div class="small text-muted">Date: <%= new Date(test.createdAt).toLocaleString() %></div>
        </div>
        <div>
          <a class="btn btn-outline-primary" href="/patient/reports/<%= test._id %>/pdf">Download PDF</a>
        </div>
      </div>
      <hr/>
      <h6>Summary</h6>
      <p><%= (test.result && test.result.summary) ? test.result.summary : (test.summary || 'No summary') %></p>

      <% if (test.result) { %>
        <h6>Detailed Results</h6>
        <table class="table">
          <thead><tr><th>Parameter</th><th>Value</th></tr></thead>
          <tbody>
            <% Object.keys(test.result).forEach(function(k){ if(k!=='summary'){ %>
              <tr><td><%= k %></td><td><%= test.result[k] %></td></tr>
            <% } }); %>
          </tbody>
        </table>
      <% } %>

      <% if (test.aiInterpretation) { %>
        <div class="alert alert-warning">
          <strong>AI Interpretation:</strong> <%= test.aiInterpretation %>
        </div>
      <% } %>

      <% if (test.reportFile) { %>
        <div class="mt-3">
          <h6>Uploaded Report File</h6>
          <a href="/public/reports/<%= test.reportFile %>" target="_blank" class="btn btn-sm btn-secondary">Open file</a>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
