<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Confirm Booking - Medora</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { background:#f6f9fb; font-family:Inter, Arial, sans-serif; }
    .wrap { max-width:780px; margin:40px auto; }
    .card { border-radius:12px; padding:20px; box-shadow:0 20px 50px rgba(12,40,34,0.06); background:#fff; }
    .img-side { width:160px; height:120px; object-fit:cover; border-radius:10px; }
  </style>
</head>

<body>
  <div class="wrap">
    <div class="card">

      <h4>Confirm Your Booking</h4>
      <p class="text-muted">Review test details and confirm your booking.</p>

      <div class="d-flex gap-3 align-items-start mt-3">

        <!-- Image from your public/assets folder -->
        <img src="/assets/CBC.png" class="img-side">

        <div style="flex:1; margin-top:10px;">
          <h5><%= testType.name %></h5>
          <p class="text-muted"><%= testType.description || 'No description.' %></p>

          <div class="row mt-3">
            <div class="col-md-6">
              <strong>Date</strong>
              <div><%= new Date(date).toLocaleDateString() %></div>
            </div>
            <div class="col-md-6">
              <strong>Time</strong>
              <div><%= time %></div>
            </div>
          </div>

          <div class="mt-3">
            <strong>Price</strong>
            <div>₹ <%= testType.price %></div>
          </div>
        </div>
      </div>

      <form action="/patient/book/confirm/submit" method="post" class="mt-4">
        <input type="hidden" name="testTypeId" value="<%= testType._id %>">
        <input type="hidden" name="date" value="<%= date %>">
        <input type="hidden" name="time" value="<%= time %>">

        <button type="submit" class="btn btn-success">Confirm Booking</button>
        <a href="/patient/book" class="btn btn-outline-secondary ms-2">Back</a>
      </form>

    </div>
  </div>
</body>
</html>
