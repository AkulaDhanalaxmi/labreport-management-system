<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Booking Successful</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { background:#f6f9fb; font-family:Inter, Arial, sans-serif; }
    .wrap { max-width:700px; margin:60px auto; text-align:center; }
    .card { background:#fff; padding:28px; border-radius:12px; box-shadow:0 18px 50px rgba(12,40,34,0.06); }
    .img { width:140px; height:120px; object-fit:cover; border-radius:10px; margin:20px auto; }
  </style>
</head>

<body>
  <div class="wrap">
    <div class="card">

      <h3>🎉 Booking Successful!</h3>

      <% if (test) { %>
        <p>Your <strong><%= test.testType.name %></strong> is scheduled on  
        <strong><%= new Date(test.scheduledDate).toLocaleDateString() %></strong>  
        at <strong><%= test.scheduledTime %></strong>.</p>

        <img src="<%= successImage %>" class="img">
      <% } else { %>
        <p>Booking completed.</p>
      <% } %>

      <a href="/patient/dashboard" class="btn btn-primary mt-3">OK — Go to Dashboard</a>
    </div>
  </div>
</body>
</html>
