
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<title>View Report</title></head><body>
<%- include("../partials/sidebar") %>
<div class="container mt-4">
  <h2>Report — <%= test.testType ? test.testType.name : '' %></h2>
  <p>Status: <strong><%= test.status %></strong></p>
  <% if (test.reportFile) { %>
    <p><a target="_blank" href="/public/uploads/<%= test.reportFile %>">Download Report</a></p>
  <% } else { %>
    <p>Report not yet uploaded.</p>
  <% } %>
</div>
<%- include('../partials/footer') %>
</body></html>
