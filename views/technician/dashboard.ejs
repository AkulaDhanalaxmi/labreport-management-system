<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<title>Technician Dashboard</title></head><body>
<%- include('../partials/header') %>
<div class="container mt-4">
  <% if (message) { %><div class="alert alert-<%= message.type %>"><%= message.text %></div><% } %>
  <h2>Technician Dashboard — All Tests</h2>
  <table class="table">
    <thead><tr><th>Patient</th><th>Test</th><th>Status</th><th>Action</th></tr></thead>
    <tbody>
      <% tests.forEach(function(t){ %>
        <tr>
          <td><%= t.patient ? t.patient.name : '—' %></td>
          <td><%= t.testType ? t.testType.name : '—' %></td>
          <td><%= t.status %></td>
          <td>
            <% if (t.status !== 'completed') { %>
              <form enctype="multipart/form-data" method="POST" action="/technician/upload/<%= t._id %>">
                <input type="file" name="report" required />
                <button class="btn btn-sm btn-primary">Upload</button>
              </form>
            <% } else { %>
              <a target="_blank" href="/public/uploads/<%= t.reportFile %>">View Report</a>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
</body></html>
